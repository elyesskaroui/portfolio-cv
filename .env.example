# EmailJS — contact form delivery.
# These identifiers are public by design (they ship in the client bundle).
# Protect the endpoint by restricting allowed domains in your EmailJS dashboard.
# Copy this file to `.env` and fill in your own values to override the defaults.

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
